<?xml version="1.0" encoding="utf-8"?>
<project>

	<app title="FNF': Psych Engine Mobile"
	     file="PsychEngine"
	     packageName="com.brenninho.psychenginemobile"
	     main="Main"
	     version="0.2.8"
	     company="Brenninho" />

	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<section if="android">
		<permission android:name="android.permission.INTERNET" />
		<permission android:name="android.permission.ACCESS_NETWORK_STATE" />
		<permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
		<permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
		<permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" if="android" />
		<permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
		<permission android:name="android.permission.WAKE_LOCK" />
		<permission android:name="android.permission.VIBRATE" />
	</section>

	<config:android minimum-sdk-version="21" />
	<config:android target-sdk-version="34" />
	<config:android build-tools-version="34.0.0" />

	<app preloader="flixel.system.FlxPreloader" />
	<set name="SWF_VERSION" value="11.8" />

	<define name="MODS_ALLOWED" if="desktop || mobile" />
	<define name="HSCRIPT_ALLOWED" if="desktop || mobile" />
	<define name="LUA_ALLOWED" if="desktop || mobile" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="TRANSLATIONS_ALLOWED" />
	<define name="IRIS_DEBUG" if="debug" />

	<define name="MULTITHREADED_LOADING" />
	<define name="SHOW_LOADING_SCREEN" />
	<define name="PSYCH_WATERMARKS" />

	<section if="officialBuild">
		<define name="TITLE_SCREEN_EASTER_EGG" />
		<define name="BASE_GAME_FILES" />
		<define name="VIDEOS_ALLOWED" if="windows || linux || android || mac || ios" unless="32bits" />
	</section>

	<window
		width="1280"
		height="720"
		fps="60"
		background="#000000"
		hardware="true"
		vsync="false"
		allow-high-dpi="true"
	/>

	<window if="html5" resizable="true" />

	<window
		if="desktop"
		orientation="landscape"
		fullscreen="false"
		resizable="true"
		vsync="false"
	/>

	<window
		if="mobile"
		orientation="landscape"
		fullscreen="true"
		width="0"
		height="0"
		resizable="false"
		antialiasing="0"
	/>

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<classpath name="source" />
	<java path="source" if="android" />

	<define name="CRASH_HANDLER" if="desktop release" />

	<assets path="assets/fonts" if="exists('assets/fonts')" />

	<assets path="assets/shared" exclude="*.ogg" if="web && exists('assets/shared')" />
	<assets path="assets/shared" exclude="*.mp3" if="!web && exists('assets/shared')" />

	<assets path="assets/embed" exclude="*.ogg" if="web && exists('assets/embed')" embed="true" />
	<assets path="assets/embed" exclude="*.mp3" if="!web && exists('assets/embed')" embed="true" />

	<assets path="assets/videos" if="VIDEOS_ALLOWED && exists('assets/videos')" />

	<assets path="assets/songs" exclude="*.ogg" if="web && exists('assets/songs')" />
	<assets path="assets/songs" exclude="*.mp3" if="!web && exists('assets/songs')" />

	<assets path="assets/sounds" exclude="*.ogg" if="web && exists('assets/sounds')" />
	<assets path="assets/sounds" exclude="*.mp3" if="!web && exists('assets/sounds')" />

	<assets path="assets/week_assets" rename="assets" exclude="*.ogg" if="web && exists('assets/week_assets')" />
	<assets path="assets/week_assets" rename="assets" exclude="*.mp3" if="!web && exists('assets/week_assets')" />

	<section if="TITLE_SCREEN_EASTER_EGG">
		<assets path="assets/secrets" rename="assets/shared" exclude="*.ogg" if="web && exists('assets/secrets')" />
		<assets path="assets/secrets" rename="assets/shared" exclude="*.mp3" if="!web && exists('assets/secrets')" />
	</section>

	<section if="TRANSLATIONS_ALLOWED">
		<assets path="assets/translations" rename="assets" exclude="*.ogg" if="web && exists('assets/translations')" />
		<assets path="assets/translations" rename="assets" exclude="*.mp3" if="!web && exists('assets/translations')" />
	</section>

	<section if="BASE_GAME_FILES">
		<assets path="assets/base_game" rename="assets" exclude="*.ogg" if="web && exists('assets/base_game')" />
		<assets path="assets/base_game" rename="assets" exclude="*.mp3" if="!web && exists('assets/base_game')" />

		<haxelib name="grig.audio" if="BASE_GAME_FILES" />
		<haxelib name="funkin.vis" if="BASE_GAME_FILES" />
	</section>

	<section if="MODS_ALLOWED">
		<assets path="example_mods" rename="mods" embed="false" type="template" if="!mac && exists('example_mods')" />
		<assets path="example_mods" rename="mods" embed="false" if="mac && exists('example_mods')" />
		<assets path="list.txt" rename="modsList.txt" if="exists('list.txt')" />
	</section>

	<assets path="art/readme.txt" rename="do NOT readme.txt" if="exists('art/readme.txt')" />

	<section if="desktop">
		<assets path="alsoft.txt" rename="plugins/alsoft.ini" type="text" if="windows && exists('alsoft.txt')" />
		<assets path="alsoft.txt" rename="plugins/alsoft.conf" type="text" if="!windows && exists('alsoft.txt')" />
	</section>

	<haxelib name="flixel" />
	<haxelib name="flixel-addons" version="3.3.2" />
	<haxelib name="tjson" version="1.4.0" />

	<haxelib name="linc_luajit" if="LUA_ALLOWED" />
	<haxelib name="hscript-iris" if="HSCRIPT_ALLOWED" version="1.1.3" />
	<haxelib name="hxvlc" if="VIDEOS_ALLOWED" version="2.0.1" />
	<haxelib name="flxanimate" />
	<haxelib name="hxcpp-debug-server" if="debug" />

	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB" />
	<haxedef name="NO_PRECOMPILED_HEADERS" if="linux || android" />
	<haxedef name="HXC_LIBVLC_LOGGING" if="VIDEOS_ALLOWED debug" />
	<haxedef name="HXVLC_NO_SHARE_DIRECTORY" if="VIDEOS_ALLOWED" />

	<define name="x86_BUILD" if="32bits" />

	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />

	<haxedef name="HXCPP_CHECK_POINTER" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_LINE" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_TRACE" if="CRASH_HANDLER" />

	<haxedef name="no-deprecation-warnings" />
	<haxedef name="message.reporting" value="pretty" />
	<haxedef name="hscriptPos" if="HSCRIPT_ALLOWED" />

	<haxeflag name="--macro" value="allowPackage('flash')" />
	<haxeflag name="--macro" value="include('my.pack')" />

	<compilerflag value="-O3" if="android && !debug" />
	<compilerflag value="-ffast-math" if="android && !debug" />

	<assets path="art/icons/iconOG.png" rename="icon.png" if="(linux || mac) && exists('art/icons/iconOG.png')" />
	<icon path="art/icons/icon16.png" size="16" if="exists('art/icons/icon16.png')" />
	<icon path="art/icons/icon32.png" size="32" if="exists('art/icons/icon32.png')" />
	<icon path="art/icons/iconOG.png" if="exists('art/icons/iconOG.png')" />

</project>
